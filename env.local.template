# Copy to .env.local and fill in. PowerShell: Copy-Item env.local.template .env.local
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only for `npm run db:apply` (schema changes). Never commit or share.
# Supabase -> Connect -> Session pooler URI (URL-encode special characters in the password).
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional, for a future AI strategy label.
GEMINI_API_KEY=
