# Copy to .env.local and fill in. PowerShell: Copy-Item env.local.template .env.local
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only for `npm run db:apply` (schema changes). Never commit or share.
# Supabase -> Connect -> Session pooler URI (URL-encode special characters in the password).
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Nightly fantasy-points sync (app/api/cron/sync-points). Set both on Vercel too.
# Supabase -> Project Settings -> API -> service_role key. Server only; never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional, for a future AI strategy label.
GEMINI_API_KEY=
